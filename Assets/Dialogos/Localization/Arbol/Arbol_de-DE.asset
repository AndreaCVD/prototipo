      m_Items: []
  - m_Id: 1983228999430148
    m_Localized: "\xA1EY! Cuidado"
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430149
    m_Localized: Arbol
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430150
    m_Localized: Un arbol te ha intimidado...
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430151
    m_Localized: "(A lo alto del \xE1rbol ves un nido de pajaros, seria una pena
      que cayesen...\xBFverdad?)"
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430152
    m_Localized: "(Es s\xF3lo un \xE1rbol...la raz\xF3n por la que puedes escucharlo
      es un misterio, quiz\xE1s la magia de la mazmorra le llega las ra\xEDzes)"
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430153
    m_Localized: "El \xE1rbol se ha sonrojado. \xA1Te da dado un regalo!)"
    m_Metadata:
      m_Items: []
  - m_Id: 1983228999430154
    m_Localized: "(Una pi\xF1a casi te cae en la cabeza...tiene pinta que ha sido
      a prop\xF3sito)"
    m_Metadata:
      m_Items: []
