  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Libro Jefe_de-DE
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de-DE
  m_SharedData: {fileID: 11400000, guid: 900f512c17324f54fae6655aaa49cf62, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 299902479691776
    m_Localized: Que lejos has llegado...
    m_Metadata:
      m_Items: []
  - m_Id: 299902530023424
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 299902534217728
    m_Localized: "Has conseguio liberar a ese mediano, y a la elfa esa...que quieres
      exactamente, \xBFquiz\xE1s mi muerte?"
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606336
    m_Localized: Luchar
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606337
    m_Localized: Irse
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606338
    m_Localized: "Me sorpende que no hayas liberado a nadie, al final seremos m\xE1s
      parecidos de lo que cre\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606339
    m_Localized: No me compares.
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606340
    m_Localized: Carlos
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606341
    m_Localized: "Es tu \xFAltima advertencia, da la vuelta, y no vuelvas."
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606342
    m_Localized: El Creador
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606343
    m_Localized: "(No dices nada, la extra\xF1a persona tampoco se mueve)"
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606344
    m_Localized: Tu lo has querido...
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606345
    m_Localized: "Respondeme, \xBFeres tu el tercer compa\xF1ero al que ten\xEDa
      que rescatar? \xBFLerendur?"
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606346
    m_Localized: "\xBFLerendur? No, no, yo soy el CREADOR."
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606347
    m_Localized: "Todo lo que ves, existe por m\xED, para m\xED. LLevo d\xE9cadas
      perfeccionando esta mazmorra..."
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606348
    m_Localized: Hasta que esos tres se metieron y empezaron a matar a mis creaciones,
      tuve que paralos, seguro me entiendes.
    m_Metadata:
      m_Items: []
  - m_Id: 299902542606349
    m_Localized: Pero cuando por fin estaba todo controlado, vino una cuarta persona...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
