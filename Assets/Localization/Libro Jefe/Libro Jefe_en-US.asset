  m_TableData:
  - m_Id: 27105725495177216
    m_Localized: "\xA1\xBFQue has hecho?!"
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148736
    m_Localized: Libro
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148737
    m_Localized: Todo mi trabajo, mis hechizos...TU NO PINTAS NADA AQUI
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148738
    m_Localized: Combatir
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148739
    m_Localized: Unirse al libro
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148740
    m_Localized: Irse de este lugar
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148741
    m_Localized: "Aunque...que te parecer\xEDa ocuper su lugar? "
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148742
    m_Localized: "\xBFY bien? Dec\xEDdete"
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148743
    m_Localized: "Vine aqu\xED para acabar el trabajo, depu\xE9s ya me ir\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148744
    m_Localized: Carlos
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148745
    m_Localized: "Me unir\xE9 a ti, pero libera al elfo."
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148746
    m_Localized: Trato, espero que nos llevemos bien hehe
    m_Metadata:
      m_Items: []
  - m_Id: 27105725516148747
    m_Localized: "No me unire a ti...pero volver\xE9"
    m_Metadata:
      m_Items: []
