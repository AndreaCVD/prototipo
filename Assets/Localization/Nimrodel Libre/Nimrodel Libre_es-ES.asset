MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Nimrodel Libre_es-ES
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: f33ec81ece197714f8835bb327ce54bf, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 40368874100944896
    m_Localized: "Hola, hola, socorrista, \xBFc\xF3mo te va todo?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333504
    m_Localized: Nim
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333505
    m_Localized: No soy socorrista
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333506
    m_Localized: "S\xFAper bien, y a ti?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333507
    m_Localized: "Bueno, pero me sacaste de all\xE1 sin questinartelo dos veces,
      ser\xE1 un don tuyo."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333508
    m_Localized: "\xA1Genial!"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333509
    m_Localized: "\xA1Rescataste a todo el mundo! Much\xEDssimas gracias"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333510
    m_Localized: Nim
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333511
    m_Localized: Muchas gracias
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333512
    m_Localized: Etkis
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333513
    m_Localized: "No se que habr\xEDas hecho sino jaja"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333514
    m_Localized: Lerendur
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333515
    m_Localized: "No hay de qu\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333516
    m_Localized: Carlos
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333517
    m_Localized: "Gracias a ti Etkis lleg\xF3 bien aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333518
    m_Localized: "Podr\xEDas haberme venido a yudar tu tambi\xE9n..."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333519
    m_Localized: "\xA1Hab\xEDa una armadura periguiendome!"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333520
    m_Localized: "Seguro...Por cierto, \xBFhas visto a otro elfo?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333521
    m_Localized: "Se llama Lerendur, \xBFqu\xE9 le habr\xE1 pasado?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333522
    m_Localized: Gracias a ti Lerendur ha podido volver.
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333523
    m_Localized: Nim
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333524
    m_Localized: "Aunque aqu\xED arriba estoy un poco sola, y ese viejo es un poco
      raro..."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333525
    m_Localized: Cuando quisimos bajar nos miro de lejos, sin decir nada...
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333526
    m_Localized: "Espera... \xA1\xBFsigue con ese ba\xF1ador?!"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333527
    m_Localized: "Aunque no recuerdo mucho lo que paso...pero hab\xEDa un libro que
      nohe acabo de leer."
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333528
    m_Localized: "Por cierto, \xBFhas visto un mediano por all\xE0?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333529
    m_Localized: "Que triste, tenia muchos conjuros de magia. \xBFY si volvemos?"
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333530
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 40368874109333531
    m_Localized: "Seguro esta robando cofres por all\xED..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
