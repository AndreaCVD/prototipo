  m_TableData:
  - m_Id: 153314717696
    m_Localized: "Manual del aventurero. \xBFQu\xE9 quieres leer?"
    m_Metadata:
      m_Items: []
  - m_Id: 153314717697
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 153314717698
    m_Localized: "Estad\xEDsticas"
    m_Metadata:
      m_Items: []
  - m_Id: 153314717699
    m_Localized: Inventario
    m_Metadata:
      m_Items: []
  - m_Id: 153314717700
    m_Localized: "Missi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 153314717701
    m_Localized: Mazmorra
    m_Metadata:
      m_Items: []
  - m_Id: 153314717702
    m_Localized: Dejar de leer
    m_Metadata:
      m_Items: []
  - m_Id: 153314717703
    m_Localized: "Fuerza, destreza y carisma son los stats que te ayudar\xE1n en
      combate."
    m_Metadata:
      m_Items: []
  - m_Id: 153314717704
    m_Localized: Manual
    m_Metadata:
      m_Items: []
  - m_Id: 153314717705
    m_Localized: "Mientras que la Constituci\xF3n y tu Clase de Armadura (CA), ser\xE1n
      tus vitales."
    m_Metadata:
      m_Items: []
  - m_Id: 153314717706
    m_Localized: "\xA1\xA1Encuentra monedas, pociones y armaduras, en tu bolsa no
      parece haber l\xEDmite!!"
    m_Metadata:
      m_Items: []
  - m_Id: 153314717707
    m_Localized: Con la "i" puedes investigar que hay en tu bolsa, y usarlo tanto
      dentro como fuera de combate.
    m_Metadata:
      m_Items: []
  - m_Id: 153314717708
    m_Localized: "No tengo ning\xFAn registro...es mi primera misi\xF3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 153314717709
    m_Localized: Carlos
    m_Metadata:
      m_Items: []
  - m_Id: 153314717710
    m_Localized: "Las mazmorr\xE1s son lugares magicos que suelen ser creadas por
      grandes hechiceros."
    m_Metadata:
      m_Items: []
  - m_Id: 153314717711
    m_Localized: "De los cuales a\xFAn pueden vivir por all\xE1. "
    m_Metadata:
      m_Items: []
  - m_Id: 153314717712
    m_Localized: 'NOTA: no suelen ser muy agradables (no molestar)'
    m_Metadata:
      m_Items: []
