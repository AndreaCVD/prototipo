  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Viejo Tunica_es-ES
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 815d8418464589a4cbd0763fcc0c6dec, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 25650014345031680
    m_Localized: "Ah, tu eres el del rescate, \xBFno es as\xED?"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586112
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586113
    m_Localized: "\xBFQue pasa? \xBFTienes miedo?"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586114
    m_Localized: Yusseif
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586115
    m_Localized: "Tienes que buscar un grupo de tres aventureros que se qued\xF3
      atrapado buscando algo. Una banda de in\xFAtiles, vaya. "
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586116
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586117
    m_Localized: "Y tu... Porfin te has decidido a venir, eh, que ya tardabas. F\xEDjate
      que hasta me iba a poner yo y todo. "
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586118
    m_Localized: "Pero como ves, yo estoy muy mayor como para rescatar a nadie, as\xED
      que tendr\xE1s que hacerlo tu."
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586119
    m_Localized: (Observar detenidamente)
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586120
    m_Localized: "\xBFSeria tan amable de obsequiarme con su ayuda?"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586121
    m_Localized: (Quedarse callado)
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586122
    m_Localized: "\xBF...qu\xE9 le pasa?"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586123
    m_Localized: Carlos
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586124
    m_Localized: "Bueno, si me lo dices as\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586125
    m_Localized: Yusseif
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586126
    m_Localized: No. Ponte a trabajar.
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586127
    m_Localized: "\xBFA qu\xE9 esperas? Va, a trabajar. Yo me quedar\xE9 aqu\xED
      sentado, que me duelen los pies."
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586128
    m_Localized: "...Si quieres practicar tienes ese \xE1rbol redondo."
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586129
    m_Localized: "Puedo irte a buscar pociones al pueblo, \xA1y no te cobro comisiones!"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586130
    m_Localized: "\xBFC\xF3mo lo ves?"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586131
    m_Localized: "Pelear con \xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586132
    m_Localized: "Ir a entrenar con el \xE1rbol"
    m_Metadata:
      m_Items: []
  - m_Id: 25650014378586133
    m_Localized: Irse
    m_Metadata:
      m_Items: []
  - m_Id: 25650014382780416
    m_Localized: "\xBFQuieres practicar? Muy bien."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
