@import url("project://database/Assets/UI/Styles/general_colors.uss?fileID=7433441132597879392&guid=ad6a76f9ae4c3674d898b1a5433c7bf6&type=3#general_colors");

.combat-screen {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-safe);
    display: none;
}

.combat-top {
    flex-direction: row;
    justify-content: space-between;
    height: 45%;
}

.combat-zone {
    width: 30%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: var(--space-md);
}
.combat-zone--player { background-color: rgba(68, 28, 4, 0.25); border-radius: var(--btn-radius); }
.combat-zone--enemy  { background-color: rgba(158, 6, 6, 0.15); border-radius: var(--btn-radius); }

.combat-sprite {
    flex-grow: 1;
    width: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.combat-hp {
    width: 80%;
    flex-direction: column;
}

.combat-hp > .combat-hp__label {
    margin-bottom: 4px;
}

.combat-hp__label { font-size: var(--font-size-label); color: var(--color-antique-white); }
.combat-hp__bar { height: 8px; background-color: rgba(255,255,255,0.1); border-radius: 4px; }
.combat-hp__fill { height: 100%; border-radius: 4px; background-color: #1D9E75; }
.combat-hp__fill--enemy { background-color: var(--color-crimson-red); }

.combat-dialog {
    width: 32%;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: var(--btn-radius);
    padding: var(--space-lg);
    justify-content: flex-end;
}
.combat-dialog__text {
    font-size: var(--font-size-body);
    color: var(--color-antique-white);
    -unity-font-definition: var(--font-regular);
    white-space: normal;
}

.combat-menu {
    width: 55%;
    align-self: center;
    flex-direction: column;
}

.combat-menu > .combat-section-label {
    margin-bottom: var(--space-md);
}

.combat-menu > .combat-row {
    margin-bottom: var(--space-md);
}

.combat-menu > .combat-divider {
    margin-bottom: var(--space-md);
}

.combat-row {
    flex-direction: row;
    justify-content: center;
}
.combat-row > .combat_btns {
    flex: 1;
    max-width: 320px;
    margin-top: 0;
    margin-right: var(--space-md);
}

.combat-divider {
    height: 1px;
    background-color: rgba(255, 237, 200, 0.15);
    margin-left: var(--space-xl);
    margin-right: var(--space-xl);
}